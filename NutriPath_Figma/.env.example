# API requests use the same-origin /api proxy configured in Vite and Vercel.
# This keeps the HttpOnly session cookie first-party and out of JavaScript.
# Leave this empty when using the proxy above. Set it only when deploying
# without a proxy, for example: https://nutripath-l4rk.onrender.com
VITE_API_BASE_URL=

# Supabase Auth public config for Google/Facebook OAuth
# Use your Supabase project URL, for example: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
